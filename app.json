{
  "expo": {
    "name": "Chi Expense",
    "slug": "chi-expense",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.chiexpense.app",
      "buildNumber": "1.1.0",
      "icon": {
        "dark": "./assets/icon-dark.png",
        "tinted": "./assets/icon-tinted.png"
      },
      "splash": {
        "image": "./assets/splash.png",
        "resizeMode": "contain",
        "backgroundColor": "#FFFFFF",
        "dark": {
          "image": "./assets/splash-dark.png",
          "backgroundColor": "#000000"
        }
      },
      "infoPlist": {
        "NSCameraUsageDescription": "Chi Expense uses your camera to scan receipts and extract expense information.",
        "NSPhotoLibraryUsageDescription": "Chi Expense accesses your photos to let you select receipt images for scanning.",
        "NSPhotoLibraryAddUsageDescription": "Chi Expense saves receipt photos to your library.",
        "NSFaceIDUsageDescription": "Chi Expense uses Face ID to secure your financial data.",
        "UIBackgroundModes": ["fetch"]
      }
    },
    "android": {
      "package": "com.chiexpense.app",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "RECEIVE_BOOT_COMPLETED"
      ]
    },
    "scheme": "chi-expense",
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Chi Expense accesses your photos to let you select receipt screenshots for expense tracking."
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/splash.png",
          "dark": {
            "image": "./assets/splash-dark.png",
            "backgroundColor": "#000000"
          },
          "imageWidth": 200
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "newArchEnabled": true
          },
          "android": {
            "newArchEnabled": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
